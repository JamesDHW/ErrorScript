>               : ^^^^^
>Error : ErrorConstructor
>      : ^^^^^^^^^^^^^^^^
>"x" : "x"
>    : ^^^
}
boom2();
>boom2() : void
>        : ^^^^
>boom2 : () => void
>      : ^^^^^^^^^^

try {
    boom2();
