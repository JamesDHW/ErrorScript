function readConfig(raw: string) {
>readConfig : (raw: string) => Record<string, unknown>
>           : ^   ^^      ^^^^^                       
>raw : string
>    : ^^^^^^

    const obj = JSON.parse(raw); // EXPECT: throws SyntaxError (stdlib)
>obj : any
>    : ^^^
>JSON.parse(raw) : any
>                : ^^^
>JSON.parse : (text: string, reviver?: (this: any, key: string, value: any) => any) => any
>           : ^    ^^      ^^       ^^^                                           ^^^^^   
>JSON : JSON
>     : ^^^^
>parse : (text: string, reviver?: (this: any, key: string, value: any) => any) => any
>      : ^    ^^      ^^       ^^^                                           ^^^^^   
>raw : string
>    : ^^^^^^

    if (typeof obj !== "object" || obj === null) throw new ParseError("not an object");
>typeof obj !== "object" || obj === null : boolean
>                                        : ^^^^^^^
>typeof obj !== "object" : boolean
>                        : ^^^^^^^
>typeof obj : "string" | "number" | "bigint" | "boolean" | "symbol" | "undefined" | "object" | "function"
>           : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>obj : any
>    : ^^^
>"object" : "object"
>         : ^^^^^^^^
>obj === null : boolean
>             : ^^^^^^^
>obj : any
>    : ^^^
>new ParseError("not an object") : ParseError
>                                : ^^^^^^^^^^
>ParseError : typeof ParseError
>           : ^^^^^^^^^^^^^^^^^
>"not an object" : "not an object"
>                : ^^^^^^^^^^^^^^^

    return obj as Record<string, unknown>;
>obj as Record<string, unknown> : Record<string, unknown>
>                               : ^^^^^^^^^^^^^^^^^^^^^^^
>obj : any
>    : ^^^
}

async function loadConfig(remote: boolean) {
>loadConfig : (remote: boolean) => Promise<Record<string, unknown>>
