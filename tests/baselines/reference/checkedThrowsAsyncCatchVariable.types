>readConfig : (raw: string) => Record<string, unknown>
>           : ^   ^^      ^^^^^                       
>text : string
>     : ^^^^^^
    }
    const local = readFromDisk("config.json");
>local : string
>      : ^^^^^^
>readFromDisk("config.json") : string
>                            : ^^^^^^
>readFromDisk : (path: string) => string throws StorageError
>             : ^    ^^      ^^^^^      ^^^^^^^^^^^^^^^^^^^^
>"config.json" : "config.json"
>              : ^^^^^^^^^^^^^

    return readConfig(local);
