=== finally_contributes.ts ===
function boom() {
>boom : () => void
>     : ^^^^^^^^^^

    throw new Error("x");
>new Error("x") : Error
>               : ^^^^^
>Error : ErrorConstructor
>      : ^^^^^^^^^^^^^^^^
>"x" : "x"
>    : ^^^
}
function withFinally() {
>withFinally : () => void
>            : ^^^^^^^^^^

    try {
        boom();
>boom() : void
>       : ^^^^
>boom : () => void
>     : ^^^^^^^^^^

    } catch (e) {
>e : Error
>  : ^^^^^

    } finally {
        throw "finally";
>"finally" : "finally"
>          : ^^^^^^^^^
    }
}
withFinally();
>withFinally() : void
>              : ^^^^
>withFinally : () => void
>            : ^^^^^^^^^^

